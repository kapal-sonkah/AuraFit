  "model_contract": {
    "_note": "Ini adalah 'kontrak' antara Python model (Colab/server) dan backend",
    "model_type": "Neural Network (Keras Sequential) + Rule-based engine",
    "input_features": {
      "order": "HARUS SAMA PERSIS dengan urutan saat training",
      "features": [
        {"index": 0, "name": "MET_Value", "type": "float", "description": "MET estimasi awal dari BMI: max(1.0, 8.0 - (bmi - 18.5) * 0.2)"},
        {"index": 1, "name": "Category_Encoded", "type": "integer", "description": "Label-encoded dari category string via le_category.transform()"},
        {"index": 2, "name": "Goal_Encoded", "type": "integer", "description": "Label-encoded dari goal string via le_goal.transform()"},
        {"index": 3, "name": "User_BMI", "type": "float", "description": "BMI user yang dihitung: weight / (height/100)^2"},
        {"index": 4, "name": "Streak_Week", "type": "integer", "description": "Minggu ke-berapa user dalam program: streak_days // 7"}
      ],
      "preprocessing": "scaler_nn.transform(fitur) — StandardScaler, WAJIB disimpan dan di-load"
    },
    "output": {
      "type": "softmax probabilities",
      "classes": ["Light", "Moderate", "Sedentary", "Vigorous"],
      "predicted_class": "le_intensity.classes_[np.argmax(pred_proba)]",
      "confidence": "round(np.max(pred_proba) * 100, 1)"
    },
    "artifacts_to_save_and_deploy": [
      {"file": "nn_model.h5 atau nn_model.keras", "description": "Model NN yang sudah di-train"},
      {"file": "scaler_nn.pkl", "description": "StandardScaler — WAJIB sama dengan saat training"},
      {"file": "le_intensity.pkl", "description": "LabelEncoder untuk Intensity_Level"},
      {"file": "le_category.pkl", "description": "LabelEncoder untuk Category"},
      {"file": "le_goal.pkl", "description": "LabelEncoder untuk Goal_Tag"},
      {"file": "exercise_balanced_3000.csv", "description": "Dataset untuk filtering rekomendasi"}
    ],
    "rule_based_formulas": {
      "bmi": "weight_kg / (height_m ** 2)",
      "bmi_categories": {
        "Underweight": "bmi < 18.5",
        "Normal": "18.5 <= bmi < 25",
        "Overweight": "25 <= bmi < 30",
        "Obesitas": "bmi >= 30"
      },
      "bmr_male": "10 * weight + 6.25 * height_cm - 5 * age + 5",
      "bmr_female": "10 * weight + 6.25 * height_cm - 5 * age - 161",
      "ideal_weight_male": "height_cm - 100 - ((height_cm - 150) / 4)",
      "ideal_weight_female": "height_cm - 100 - ((height_cm - 150) / 2.5)",
      "calories_burned": "MET_Value * weight_kg * (duration_minutes / 60)",
      "estimated_steps": "int((calories_burned / weight_kg) * 1000 * 2.2) if calories_burned > 0 else 0",
      "days_to_ideal": "int((weight_to_lose_kg * 7700) / avg_daily_calories_burned)",
      "duration_progressive": "min(base_duration.get(intensity, 30) + streak_week * 5, 60)",
      "duration_base": {
        "Sedentary": 15,
        "Light": 20,
        "Moderate": 30,
        "Vigorous": 40
      },
      "streak_broken_condition": "today_date - last_workout_date > 1 hari (kecuali hari istirahat)"
    }
  },

  "goal_category_mapping": {
    "_note": "Pemetaan goal user → category dataset (heuristik dari notebook)",
    "Weight Loss": "Walking",
    "Cardio & Agility": "Sports",
    "Cardio & Endurance": "Running",
    "Health Maintenance": "Walking",
    "Full Body Cardio": "Water Activities",
    "Core & Stamina": "Conditioning Exercise",
    "Muscle Gain": "Resistance Training"
  },

  "streak_system_rules": {
    "how_streak_works": [
      "Setiap hari user selesai olahraga → current_streak + 1",
      "Jika lewat 1 hari tanpa olahraga (bukan rest day) → streak reset ke 0",
      "Hari istirahat (rest day) TIDAK memutus streak — dihitung setiap 3-4 hari sekali",
      "Kalori yang sudah terbakar TIDAK pernah hilang meski streak putus",
      "streak_week = current_streak // 7, dipakai sebagai input NN",
      "Semakin tinggi streak_week → intensitas rekomendasi otomatis naik (progressive overload)"
    ],
    "rest_day_pattern": "Setiap hari ke-4 dan ke-7 dalam seminggu adalah hari istirahat",
    "calories_1kg_fat": 7700,
    "progress_formula": "total_calories_burned / (weight_to_lose_kg * 7700) * 100",
    "goal_achieved_condition": "progress_percent >= 100 ATAU bmi_category == 'Normal'"
  },

  "error_codes": {
    "400": "Bad Request — request body tidak valid",
    "401": "Unauthorized — token tidak ada atau expired",
    "403": "Forbidden — tidak punya akses ke resource ini",
    "404": "Not Found — user / workout tidak ditemukan",
    "409": "Conflict — workout hari ini sudah dicatat",
    "422": "Unprocessable Entity — validasi input gagal",
    "500": "Internal Server Error — error di server / model inference gagal"
  },

  "tech_stack_recommendation": {
    "backend_framework": "FastAPI (Python) — karena model sudah Python, lebih mudah integrate",
    "alternative_backend": "Express.js (Node) — kalau model di-serve terpisah via API",
    "database": "PostgreSQL — cocok untuk relational data user & workout logs",
    "model_serving": "FastAPI langsung load model .h5 saat startup, atau pisah pakai Flask/TorchServe",
    "authentication": "JWT (JSON Web Token) — simpan di header Authorization: Bearer <token>",
    "scheduler": "APScheduler atau Celery — untuk cron job cek streak putus tiap tengah malam",
    "deployment": "Railway / Render / GCP Cloud Run untuk backend + model"
  }
}
