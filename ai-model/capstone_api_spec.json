    {
      "id": "EP-01",
      "name": "Register & Onboarding User",
      "method": "POST",
      "url": "/api/v1/users/register",
      "description": "Registrasi user baru, simpan data fisik awal untuk kalkulasi BMI",
      "request_body": {
        "name": "string — nama lengkap user",
        "email": "string — email unik",
        "password": "string — min 8 karakter",
        "gender": "string — enum: ['L', 'P']",
        "weight_kg": "float — berat badan dalam kg, contoh: 90.0",
        "height_cm": "float — tinggi badan dalam cm, contoh: 165.0",
        "age": "integer — umur dalam tahun, contoh: 28",
        "goal": "string — enum: ['Weight Loss', 'Cardio & Endurance', 'Cardio & Agility', 'Muscle Gain', 'Core & Stamina', 'Full Body Cardio', 'Health Maintenance']"
      },
      "response_success": {
        "status": 201,
        "body": {
          "success": true,
          "message": "Registrasi berhasil",
          "data": {
            "user_id": "uuid-string — contoh: usr_a1b2c3d4",
            "name": "string",
            "email": "string",
            "bmi_profile": {
              "bmi": "float — contoh: 33.1",
              "bmi_category": "string — enum: ['Underweight', 'Normal', 'Overweight', 'Obesitas']",
              "ideal_weight_kg": "float — contoh: 61.4",
              "weight_to_lose_kg": "float — contoh: 28.6",
              "bmr_kcal_per_day": "integer — contoh: 1796",
              "estimated_days_to_ideal": "integer — contoh: 734"
            },
            "streak": {
              "current_streak": 0,
              "longest_streak": 0,
              "total_calories_burned": 0,
              "total_steps": 0,
              "calories_target_to_ideal": "float — contoh: 220220.0",
              "progress_percent": 0.0
            },
            "token": "string — JWT token untuk autentikasi"
          }
        }
      },
      "response_error": {
        "400": {"success": false, "message": "Email sudah terdaftar / data tidak valid"},
        "422": {"success": false, "message": "Validasi gagal", "errors": ["field: pesan error"]}
      }
    },

    {
      "id": "EP-02",
      "name": "Login",
      "method": "POST",
      "url": "/api/v1/users/login",
      "description": "Login user, return JWT token",
      "request_body": {
        "email": "string",
        "password": "string"
      },
      "response_success": {
        "status": 200,
        "body": {
          "success": true,
          "data": {
            "token": "string — JWT",
            "user_id": "string",
            "name": "string"
          }
        }
      }
    },

    {
      "id": "EP-03",
      "name": "Get Rekomendasi Olahraga Hari Ini (Core AI Endpoint)",
      "method": "GET",
      "url": "/api/v1/recommendations/today",
      "description": "Endpoint utama. Memanggil model NN untuk prediksi intensitas, lalu filter dataset, hitung kalori & langkah, return rekomendasi hari ini. Streak_week dihitung otomatis dari history user.",
      "auth": "Bearer Token (JWT)",
      "headers": {
        "Authorization": "Bearer <token>"
      },
      "query_params": {
        "user_id": "string — opsional jika sudah dari token"
      },
      "internal_process": [
        "1. Ambil data user dari DB (weight, height, age, gender, goal, streak_week)",
        "2. Hitung BMI, BMR, berat ideal → rule-based engine",
        "3. Encode fitur: [MET_estimasi, Category_Encoded, Goal_Encoded, BMI, Streak_Week]",
        "4. Panggil nn_model.predict(fitur_scaled) → dapat pred_intensity + confidence",
        "5. Filter dataset: WHERE Intensity_Level = pred_intensity AND Goal_Tag = user_goal",
        "6. Sample 1 aktivitas (random_state = streak_week agar deterministik per minggu)",
        "7. Hitung kalori: MET × weight_kg × (durasi/60)",
        "8. Estimasi langkah dari kalori",
        "9. Return JSON response di bawah"
      ],
