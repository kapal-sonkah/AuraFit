{
  "_meta": {
    "project": "AI Exercise Recommender — Capstone",
    "version": "1.0.0",
    "description": "JSON specification lengkap untuk backend REST API sistem rekomendasi olahraga berbasis BMI + Neural Network + Streak system",
    "model_used": "Neural Network (Keras/TensorFlow) + Rule-based engine",
    "dataset": "exercise_balanced_3000.csv (augmented dari exercise_800.csv)",
    "author": "Capstone Team"
  },

