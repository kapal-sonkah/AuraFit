{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/cron/daily-reset",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/cron/password-hash-backfill",
      "schedule": "1 17 * * *"
    }
  ]
}
