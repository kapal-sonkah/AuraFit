# Salin berkas ini menjadi .env, lalu isi dengan nilai milik Anda sendiri.
# Jangan pernah menuliskan nilai asli di berkas ini — .env.example ikut terbawa ke repositori.

# Server configuration
HOST=localhost
PORT=3000

# Koneksi PostgreSQL lengkap. Wajib diisi; gunakan koneksi Neon untuk
# environment cloud dan jangan menyimpan nilai asli di repository.
DATABASE_URL=

# JWT
# Terbitkan nilai acak untuk masing-masing kunci, misalnya dengan:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_KEY=
REFRESH_TOKEN_KEY=

# Rahasia untuk titik akhir cron. Penjadwal mengirimkannya sebagai
# "Authorization: Bearer <nilai>". Bila kosong, titik akhir cron menolak
# seluruh permintaan.
CRON_SECRET=
